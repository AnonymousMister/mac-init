# ==========================================
# 1. 核心运行环境加载 (Homebrew & 1Password)
# ==========================================
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# ==========================================
# 2. 规范目录配置 (XDG Base Directory Specification)
# 杜绝 CLI 与 AI 工具在 $HOME 目录下随意生成隐藏目录
# ==========================================
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/Library/Caches"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

# ==========================================
# 3. AI 工具模型与缓存集中重定向
# 统一存储到 ~/Developer/AI_Models，方便监控与一键清理
# ==========================================
export AI_DATA_DIR="$HOME/Developer/AI_Models"
export HF_HOME="$AI_DATA_DIR/huggingface"
export TORCH_HOME="$AI_DATA_DIR/torch"
export OLLAMA_MODELS="$AI_DATA_DIR/ollama"
export UV_CACHE_DIR="$HOME/Library/Caches/uv"

# ==========================================
# 4. 动态终端代理管理 (自动适配 Loon / Clash)
# ==========================================
tproxy() {
    local action="${1:-status}"
    local wifi_name="Wi-Fi"

    case "$action" in
        on)
            local http_port=$(networksetup -getwebproxy "$wifi_name" 2>/dev/null | awk '/Port:/ {print $2}')
            local socks_port=$(networksetup -getsocksfirewallproxy "$wifi_name" 2>/dev/null | awk '/Port:/ {print $2}')

            if [ -z "$http_port" ] || [ "$http_port" = "0" ]; then
                echo "❌ 未检测到系统代理端口，请确认代理软件的'系统代理'已开启"
                return 1
            fi

            export http_proxy="http://127.0.0.1:$http_port"
            export https_proxy="http://127.0.0.1:$http_port"
            export all_proxy="socks5://127.0.0.1:$socks_port"

            echo "✅ 终端代理已开启 (HTTP:$http_port / SOCKS:$socks_port)"
            ;;
        off)
            unset http_proxy https_proxy all_proxy
            echo "⭕️ 终端代理已关闭"
            ;;
        status)
            if [ -n "$http_proxy" ] || [ -n "$all_proxy" ]; then
                echo "🟢 终端代理当前状态: 已开启"
                echo "   http_proxy  = ${http_proxy:-未设置}"
                echo "   https_proxy = ${https_proxy:-未设置}"
                echo "   all_proxy   = ${all_proxy:-未设置}"
            else
                echo "⚪️ 终端代理当前状态: 未开启"
            fi
            ;;
        *)
            echo "用法: tproxy [on|off|status]"
            return 1
            ;;
    esac
}

# 终端打开时自动检查：如果 Loon 系统代理已开启，则自动为当前终端注入代理
if networksetup -getwebproxy Wi-Fi 2>/dev/null | grep -q "Enabled: Yes"; then
    tproxy on > /dev/null
fi

# ==========================================
# 5. 提示符与运行时激活
# ==========================================
export PATH="$HOME/.local/bin:$PATH"

# Starship 提示符
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# mise 多语言环境激活
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
