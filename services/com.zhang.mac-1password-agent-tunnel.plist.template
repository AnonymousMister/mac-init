<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zhang.mac-1password-agent-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/Library/Application Support/Mac1PasswordAgentTunnel/Mac1PasswordAgentTunnel.app/Contents/MacOS/Mac1PasswordAgentTunnel</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.zhang.mac-1password-agent-tunnel</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Application Support/Mac1PasswordAgentTunnel/error.log</string>
</dict>
</plist>
