#!/bin/bash
# ==============================================================================
# op-tunnel: 1Password SSH Agent 远端隧道管理工具
# ==============================================================================

set -e

# 颜色配置
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

LABEL="com.zhang.mac-1password-agent-tunnel"
DOMAIN="gui/$(id -u)"
PLIST_FILE="$HOME/Library/LaunchAgents/$LABEL.plist"
APP_NAME="Mac1PasswordAgentTunnel"
LOG_FILE="$HOME/Library/Application Support/Mac1PasswordAgentTunnel/error.log"
CONF_FILE="$HOME/.config/1password-tunnel/config"
LOCAL_SOCKET="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
NBLINK_PROCESS="nblink"

# 获取服务 PID（若运行中）
get_pid() {
  pgrep -f "$APP_NAME" 2>/dev/null | head -n 1
}

# 检查 LaunchAgent 是否已加载
is_loaded() {
  launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1
}

# 清理远端残留 socket
cleanup_remote() {
  if [ -f "$CONF_FILE" ]; then
    source "$CONF_FILE"
    local remote="${REMOTE_HOST:-zhang@100.66.1.11}"
    local remote_sock="${REMOTE_SOCK:-/home/zhang/.ssh/mac-1password.sock}"
    if [ -S "$LOCAL_SOCKET" ]; then
      /usr/bin/ssh \
        -o BatchMode=yes \
        -o ConnectTimeout=5 \
        -o "IdentityAgent=\"$LOCAL_SOCKET\"" \
        "$remote" "rm -f -- '$remote_sock'" 2>/dev/null || true
    fi
  fi
}

cmd_status() {
  echo -e "\n${BLUE}====================================================${NC}"
  echo -e "${BLUE}       🔐 1Password Agent Tunnel 运行状态监控       ${NC}"
  echo -e "${BLUE}====================================================${NC}"

  # 1. LaunchAgent 状态
  local pid="$(get_pid)"
  if is_loaded; then
    if [ -n "$pid" ]; then
      echo -e "  守护服务 (LaunchAgent) : ${GREEN}● 运行中${NC} (PID: ${BOLD}$pid${NC})"
    else
      echo -e "  守护服务 (LaunchAgent) : ${YELLOW}● 已加载 (进程正在就绪或等待重试)${NC}"
    fi
  else
    if [ -n "$pid" ]; then
      echo -e "  守护服务 (LaunchAgent) : ${YELLOW}● 未加载 (检测到残留独立进程 PID: $pid)${NC}"
    else
      echo -e "  守护服务 (LaunchAgent) : ${RED}○ 已停止 (未加载)${NC}"
    fi
  fi

  # 2. 本地 1Password Agent Socket 状态
  if [ -S "$LOCAL_SOCKET" ]; then
    echo -e "  1Password Agent Socket : ${GREEN}✓ 正常就绪${NC}"
  else
    echo -e "  1Password Agent Socket : ${RED}✗ 未就绪${NC} (未检测到 Socket，请确认 1Password 是否已开启 SSH Agent)"
  fi

  # 3. NodeLink 依赖状态
  if pgrep -x "$NBLINK_PROCESS" >/dev/null 2>&1; then
    echo -e "  前置依赖 (NodeLink)    : ${GREEN}✓ 运行中${NC}"
  else
    echo -e "  前置依赖 (NodeLink)    : ${YELLOW}○ 未运行${NC} (隧道将保持待机轮询，直至 NodeLink 启动)"
  fi

  # 4. SSH 隧道转发连接
  local ssh_pid="$(pgrep -f "ssh.*mac-1password.sock" 2>/dev/null | head -n 1)"
  if [ -n "$ssh_pid" ]; then
    echo -e "  远端 SSH 隧道链路      : ${GREEN}● 已建立连接${NC} (SSH PID: ${BOLD}$ssh_pid${NC})"
  else
    echo -e "  远端 SSH 隧道链路      : ${YELLOW}○ 未连接${NC}"
  fi

  # 5. 配置信息
  if [ -f "$CONF_FILE" ]; then
    source "$CONF_FILE"
    echo -e "  远端主机 (REMOTE_HOST) : ${CYAN}${REMOTE_HOST:-未设置}${NC}"
    echo -e "  远端 Socket (SOCK_PATH): ${CYAN}${REMOTE_SOCK:-未设置}${NC}"
  else
    echo -e "  配置信息               : ${YELLOW}未找到本地配置文件 ($CONF_FILE)${NC}"
  fi

  # 6. 最近日志检查
  echo -e "\n${BLUE}---------------- 最近错误日志 (最后 5 行) ----------------${NC}"
  if [ -f "$LOG_FILE" ] && [ -s "$LOG_FILE" ]; then
    tail -n 5 "$LOG_FILE"
  else
    echo -e "  ${GREEN}✓ 暂无错误日志记录${NC}"
  fi
  echo -e "${BLUE}====================================================${NC}\n"
}

cmd_start() {
  if is_loaded; then
    local pid="$(get_pid)"
    echo -e "${YELLOW}提示: 1Password 隧道守护服务已经在运行中${NC} (PID: ${pid:-未知})。"
    echo -e "如需重新启动，请执行: ${CYAN}op-tunnel restart${NC}"
    return 0
  fi

  if [ ! -f "$PLIST_FILE" ]; then
    echo -e "${RED}[错误] 未找到 LaunchAgent 配置文件: $PLIST_FILE${NC}"
    echo -e "请先重新运行安装配置模块。"
    return 1
  fi

  echo -e "${CYAN}>> 正在启动 1Password 隧道守护服务...${NC}"
  launchctl bootstrap "$DOMAIN" "$PLIST_FILE" 2>/dev/null || launchctl load "$PLIST_FILE" 2>/dev/null

  sleep 1
  local pid="$(get_pid)"
  if [ -n "$pid" ]; then
    echo -e "${GREEN}✓ 1Password 隧道守护服务已成功启动！${NC} (PID: ${BOLD}$pid${NC})"
  else
    echo -e "${GREEN}✓ LaunchAgent 已加载至 launchd${NC}。"
  fi
}

cmd_stop() {
  echo -e "${CYAN}>> 正在停止 1Password 隧道守护服务...${NC}"

  # 卸载 launchd 托管服务
  launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || launchctl unload "$PLIST_FILE" 2>/dev/null || true

  # 兜底清理可能残留的进程
  pkill -f "$APP_NAME" 2>/dev/null || true
  pkill -f "ssh.*mac-1password.sock" 2>/dev/null || true

  # 清理远端可能残留的 socket
  echo -e "${CYAN}>> 正在清理远端机器上的残余 Socket 句柄...${NC}"
  cleanup_remote

  echo -e "${GREEN}✓ 1Password 隧道守护进程已完全停止并清理完毕。${NC}"
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start
}

cmd_logs() {
  if [ ! -f "$LOG_FILE" ] || [ ! -s "$LOG_FILE" ]; then
    echo -e "${GREEN}✓ 暂无错误日志记录（日志文件为空）。${NC}"
    return 0
  fi

  if [ "$1" = "-f" ] || [ "$1" = "--follow" ]; then
    echo -e "${CYAN}>> 正在持续跟踪错误日志 (Ctrl+C 退出)...${NC}"
    tail -f "$LOG_FILE"
  else
    echo -e "${CYAN}>> 错误日志最新记录 (最近 30 行):${NC}"
    tail -n 30 "$LOG_FILE"
  fi
}

cmd_edit() {
  local editor="${EDITOR:-nano}"
  mkdir -p "$(dirname "$CONF_FILE")"
  "$editor" "$CONF_FILE"
}

# 命令行路由
case "${1:-status}" in
  status)
    cmd_status
    ;;
  start)
    cmd_start
    ;;
  stop)
    cmd_stop
    ;;
  restart)
    cmd_restart
    ;;
  log|logs)
    shift
    cmd_logs "$@"
    ;;
  edit|config)
    cmd_edit
    ;;
  help|-h|--help)
    echo -e "\n${BOLD}1Password Agent Tunnel 快捷管理工具${NC}"
    echo -e "用法: ${CYAN}op-tunnel${NC} <命令>\n"
    echo -e "可用命令:"
    echo -e "  ${YELLOW}status${NC}          查看隧道服务与连接监控状态 (默认)"
    echo -e "  ${YELLOW}start${NC}           启动后台守护服务"
    echo -e "  ${YELLOW}stop${NC}            立即彻底停止服务并清理远端残留 Socket"
    echo -e "  ${YELLOW}restart${NC}         重启隧道守护服务"
    echo -e "  ${YELLOW}logs [-f]${NC}       查看/跟踪错误日志"
    echo -e "  ${YELLOW}config${NC}          编辑远程主机与 Socket 配置文件"
    echo -e "  ${YELLOW}help${NC}            显示本帮助信息\n"
    ;;
  *)
    echo -e "${RED}[错误] 未知命令: $1${NC}"
    echo -e "用法: op-tunnel [status|start|stop|restart|logs|config|help]"
    exit 1
    ;;
esac
